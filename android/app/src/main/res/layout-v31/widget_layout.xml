<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="horizontal"
    android:padding="2dp"
    android:gravity="center"
    android:clipToOutline="true">

    <!-- Label "Today" -->

    <!-- Today's count -->
    <TextView
        android:id="@+id/tv_smoked_today"
        android:layout_width="39dp"
        android:layout_height="41dp"
        android:layout_below="@id/tv_today_label"
        android:layout_above="@+id/btn_log_cigarette"
        android:gravity="center"
        android:text="0"
        android:textColor="@android:color/black"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="26sp"
        android:autoSizeMaxTextSize="48sp"
        android:padding="1dp"
        android:maxLines="1"
        android:textStyle="normal"/>

    <!-- Button "+" -->
    <ImageButton
        android:id="@+id/btn_log_cigarette"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:layout_margin="10dp"
        android:src="@drawable/ic_log_cigarette"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Log cigarette"
        android:scaleType="centerInside" />

</LinearLayout>
