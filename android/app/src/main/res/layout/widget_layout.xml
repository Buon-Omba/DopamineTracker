<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="4dp"
    android:gravity="center">

    <!-- Nome della dipendenza -->
    <TextView
        android:id="@+id/tv_widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dopamine"
        android:textSize="12sp"
        android:textColor="?android:attr/textColorSecondary"
        android:textStyle="bold"
        android:layout_marginBottom="2dp" />

    <!-- Etichetta "OGGI" -->
    <TextView
        android:id="@+id/tv_today_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="OGGI"
        android:textSize="10sp"
        android:textColor="?android:attr/textColorSecondary"
        android:textStyle="bold"
        android:textAllCaps="true" />

    <!-- Conteggio odierno -->
    <TextView
        android:id="@+id/tv_smoked_today"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:textColor="?android:attr/textColorPrimary"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_margin="-2dp" />

    <!-- Pulsante "+" -->
    <ImageButton
        android:id="@+id/btn_log_cigarette"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_log_cigarette"
        android:background="@drawable/widget_button_background"
        android:contentDescription="Log cigarette"
        android:scaleType="centerInside"
        android:padding="1dp" />

</LinearLayout>
